    {
      "parameters": {
        "jsCode": "// Satu item per skenario dari skenario.json.\n// Untuk menjalankan sebagian saja, misalnya: .filter(s => [0, 2].includes(s.no))\nconst hasil = JSON.parse($input.first().json.stdout.trim().split('\\n').pop());\nreturn hasil.skenario\n  .map(s => ({ json: { no: s.no, aplikasi: s.aplikasi, peran: s.peran, tujuan: s.tujuan } }));\n"
      },
